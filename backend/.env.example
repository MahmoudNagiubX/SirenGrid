GROQ_API_KEY=
GEMINI_API_KEY=
PHASE00_ALLOW_EXTERNAL_MEDIA=false
TOMTOM_API_KEY=
GROQ_STRUCTURED_PRIMARY=qwen/qwen3.8-27b
GROQ_STRUCTURED_SECONDARY=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.8-flash
FEASIBILITY_TIMEOUT_SECONDS=30
# Optional non-secret probe point; default is the point from TomTom's official docs.
TOMTOM_TEST_POINT=52.41072,4.84239

# Phase 01 Runtime Configuration
APP_NAME=SirenGrid API
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./sirengrid.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
MAX_ROUTE_SNAP_DISTANCE_M=1500.0
NASR_CITY_DATA_DIR=data/processed/nasr_city

# Phase 02 TomTom runtime (locked prototype policy)
TOMTOM_REFRESH_INTERVAL_SECONDS=60
TOMTOM_FRESH_MAX_AGE_SECONDS=120
TOMTOM_REFRESH_TIMEOUT_SECONDS=10
TOMTOM_FLOW_STYLE=absolute
TOMTOM_FLOW_ZOOM=22
TOMTOM_FLOW_UNITS=kmph
TOMTOM_MIN_PROVIDER_CONFIDENCE=0.80
TOMTOM_MAX_GEOMETRY_SEPARATION_M=30
TOMTOM_MAX_DIRECTION_DIFFERENCE_DEGREES=30

# Simulation Demo Controls (Disabled by default)
SIMULATION_CONTROLS_ENABLED=false
